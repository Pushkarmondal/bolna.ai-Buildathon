{
  "name": "worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply bhaav --local",
    "db:migrate:remote": "wrangler d1 migrations apply bhaav --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@bhaav/shared": "*",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
