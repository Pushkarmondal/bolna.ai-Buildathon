# Copy to .dev.vars for `wrangler dev`, then fill in. Never commit .dev.vars.
# In production, set each secret with `npx wrangler secret put NAME` (run inside worker/).
# Make random values with: openssl rand -hex 24

# Groq API key (console.groq.com/keys). Used only by /v1/chat/completions.
GROQ_API_KEY=
# The custom LLM's key: Bolna sends it as `Authorization: Bearer …` to /v1/chat/completions.
LLM_SECRET=
# Bolna API key (bn-…), to place calls, mint browser-call sessions and read executions.
BOLNA_API_KEY=
# Sent by Bolna's custom functions to /tools/*.
TOOL_SECRET=
# The last part of the webhook URL: /webhooks/bolna/<WEBHOOK_SECRET>.
WEBHOOK_SECRET=
# What people type to open the app. Make it long; it guards real phone calls.
APP_PASSCODE=
# Signs the session cookie.
COOKIE_SECRET=

# Local run without Bolna: start `npm run fake-bolna` and uncomment these.
# BOLNA_BASE_URL=http://localhost:8790
# BOLNA_DESK_AGENT_ID=fake-desk
# BOLNA_CALLER_AGENT_ID=fake-caller
# BOLNA_OWNER_AGENT_ID=fake-owner
# The fake also stands in for Groq: it answers only the e2e lie test and refuses everything else.
# GROQ_BASE_URL=http://localhost:8790/groq
# Local runs against the fake Bolna place many pretend calls; lift the daily cap (real deploys keep wrangler.toml's 60).
# MAX_CALLS_PER_DAY=100000
# Local runs also allow any pretend number, any hour, webhooks from localhost, and calls for
# several orders at once (a call left live by a stopped test would otherwise hold up the rest).
# Real deploys keep wrangler.toml's values: an approved list, 10:00-19:00, Bolna's addresses, one call.
# SUPPLIER_ALLOWLIST=*
# CALL_HOURS=0-24
# BOLNA_WEBHOOK_IPS=*
# MAX_LIVE_CALLS=100
