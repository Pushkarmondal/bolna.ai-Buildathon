# Served by Cloudflare's static assets with every page and file (the Worker's own answers get the
# same through hono/secure-headers in worker/src/index.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()

# Built files carry a hash in their name, so they never change and can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
